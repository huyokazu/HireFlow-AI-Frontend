# Sao chép file này thành ".env" rồi dán API Key lấy từ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tuỳ chọn - chỉ sửa khi cần đổi model.
# Mỗi dòng là một CHUỖI model cách nhau dấu phẩy: model đầu lỗi/quá tải thì tự chuyển sang model sau.
# Chỉ ghi 1 model = tắt dự phòng.
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# GEMINI_MODEL_SMART=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# GEMINI_API_MODE=interactions
