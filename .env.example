# Expo app settings. Copy this file to `.env.local` (git-ignored) and fill it in, then restart
# `npx expo start` so the values are inlined into the bundle.
#
# Leave any of the three unset and the app runs on its built-in mock data, with no sign-in.
# Every EXPO_PUBLIC_* value ships inside the app, so only public values belong here:
# never a Supabase secret key, database password, Google client secret or Gemini API key.
#
# Expo reads EXPO_PUBLIC_*, not NEXT_PUBLIC_*: NEXT_PUBLIC_SUPABASE_URL is EXPO_PUBLIC_SUPABASE_URL
# here, and the anon key is EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY. GEMINI_API_KEY and the Google
# OAuth keys belong to the API: put them in backend/.env.local (template: backend/.env.example).

# The HireFlow API (the Next.js app in backend/). On a phone or emulator, `localhost` is the
# device itself: use your PC's LAN IP instead, e.g. http://192.168.1.20:3000, and allow port 3000
# through the firewall. The Android emulator can also reach the PC at http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project URL and publishable key (`sb_publishable_...`). Locally, `supabase status`
# prints both; the same LAN-IP rule applies to the URL on a phone (e.g. http://192.168.1.20:54321).
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to 1 to show the "Use demo account" button in release builds (it always shows in development).
EXPO_PUBLIC_DEMO_LOGIN=
