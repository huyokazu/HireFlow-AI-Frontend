# HireFlow API environment. Copy to .env.local for local work; set the same keys in Vercel for deploys.
# Never commit real values. Server-only: none of these are sent to the app.

# --- Supabase -------------------------------------------------------------------------------
# Project URL. Locally: `npx supabase status` → API_URL (http://127.0.0.1:54321).
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key: verifies user tokens and runs queries as the signed-in user (RLS applies).
SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: bypasses RLS for agent writes, Google tokens and operations actions.
SUPABASE_SECRET_KEY=

# --- HTTP -----------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (Expo web). One `*` per entry matches a
# preview subdomain, e.g. https://hireflow-web-*.vercel.app. Native apps do not need CORS.
CORS_ORIGINS=http://localhost:8081
# Shared secret for scheduled jobs; Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Google (Operations Agent: Gmail + Calendar) --------------------------------------------
# OAuth client (type "Web application") from Google Cloud Console. Leave empty to run without
# Google: the connect flow answers 503 GOOGLE_NOT_CONFIGURED and actions run in simulated mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# AES-256-GCM key that encrypts stored Google tokens: 32 random bytes, base64.
# Generate with: openssl rand -base64 32   (rotating it forces every user to reconnect Google)
GOOGLE_TOKEN_ENC_KEY=
# live: always call Google · simulated: never call Google (fake event ids and Meet links)
# auto (default): live for users with an active connection when the client id is set, else simulated.
GOOGLE_MODE=auto
# Extra comma-separated `returnTo` prefixes the connect flow may redirect to, e.g. the deployed
# Expo web origin (https://app.example.com/). Always allowed: hireflow://, http://localhost:*,
# and exp:// outside production.
GOOGLE_RETURN_TO_ALLOWLIST=
# By default the connected Google account must have a verified email equal to the HireFlow user's
# email, so a consent link forwarded to someone else cannot attach their Gmail to your account.
# Set to 1 only if recruiters sign in to HireFlow with a different address than their Gmail.
# RISK: with 1, anyone who opens a forwarded connect link grants the sender access to send mail
# and book events as them.
GOOGLE_ALLOW_ANY_ACCOUNT=

# --- Operations Agent safety ----------------------------------------------------------------
# Demo safety net: when set, every outbound email recipient and calendar attendee is replaced by
# this address (recorded as `deliveredTo` on the action). Recommended for live demos.
OPERATIONS_REDIRECT_EMAIL=
# Cap on agent emails per user per hour (default 20; Gmail's own limits are far higher).
OPERATIONS_MAX_SENDS_PER_HOUR=20

# --- Scripts only (seed-demo.ts, bench.mjs) -------------------------------------------------
# Demo account created by `npm run seed:demo` and used by `npm run bench`.
# DEMO_EMAIL=demo@hireflow.local
# DEMO_PASSWORD=
# Bench target and an optional pre-issued access token.
# BENCH_BASE_URL=http://localhost:3000
# BENCH_TOKEN=
